# FalconBroom environment template
# Copy this to /etc/falconbroom.env on your server and fill in secrets.
# Keep this file root-owned and mode 600 (chmod 600).

# Environment: use 'production' on servers
ENV=production

# JWT secret (high-entropy). Example: `openssl rand -hex 32`
JWT_SECRET=

# Public URLs
APP_URL=https://falconbroom.com
BACKEND_URL=https://api.yourdomain.com

# Cookie domain for refresh cookie. Use leading dot to share across subdomains
# e.g. COOKIE_DOMAIN=
COOKIE_DOMAIN= .falconbroom.com

# CORS allowed origins (comma-separated)
CORS_ALLOW_ORIGINS=https://falconbroom.com,https://www.falconbroom.com

# Refresh cookie name (default is fine)
REFRESH_COOKIE_NAME=falconbroom_refresh

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: key for encrypting sensitive files (Fernet base64 key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#DATA_ENC_KEY=
# Or point to a protected key file path (preferred for long keys):
#DATA_ENC_KEY_FILE=/etc/falconbroom/data_enc_key

# Optional: bootstrap admin token (dev only). Not recommended for production.
#ADMIN_TOKEN=

# Optional: AWS S3 or DigitalOcean Spaces (if you enable cloud storage for uploads)
#AWS_S3_BUCKET=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=

# Optional: PostgreSQL URL if you migrate storage to a DB
#DB_URL=postgres://user:pass@host:5432/dbname

# End of template
