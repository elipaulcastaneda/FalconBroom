# Ignore runtime data and generated artifacts
data/*
!data/.gitignore

# Virtualenvs
.venv/
venv/

# Node
node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
frontend/build/
src-tauri/target/

# Python cache
__pycache__/
*.pyc

# Secrets and env
.env
.env.*
!.env.sample
# Frontend env (keep local secrets out of git)
frontend/.env
frontend/.env.*

# Editor/IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs, DBs
*.log
*.sqlite
*.db

# Local debug artifacts
run_uvicorn*.log
run_uvicorn_deepdebug.log
scripts/*.txt
scripts/py_spy_*
# Keep tests and source tracked
!/tests/
 
# Ignore large sanitized output; allow synthetic demo folder
samples/sanitized/
!samples/demo_custom/

# Scratch / debug output
/debug/
/*_output*.txt
/run_uv*.err
/run_uv*.out
/run_uv_log.txt
/tests_list*.txt
/pytest_multi_out.txt
/history.zip
/client_early_failures.jsonl
/fixed_out.csv
/out_test.csv
/output_from_text.csv
/preview.json
/recipe*.json
/tmp_*.py
/query
*.pid

# Tauri generated
src-tauri/gen/
frontend/frontend/
