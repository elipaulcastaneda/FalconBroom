{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FalconBroom",
  "version": "0.1.0",
  "identifier": "com.falconbroom.ui",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FalconBroom",
        "width": 1200,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/falconbroom-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "publisher": "FalconBroom",
    "shortDescription": "Data profiling and cleaning"
  }
}